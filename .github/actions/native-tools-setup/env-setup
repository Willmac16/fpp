#!/bin/bash

# Resolve architecture. Note: this is dependent on the graal version
graal_arch="$(uname -m)"

# Override graal_arch when on amd64
if [[ "$graal_arch" == "x86_64" ]] || [[ "$graal_arch" == "x64" ]]
then
  graal_arch="x64"
elif [[ "$graal_arch" == "arm64" ]] || [[ "$graal_arch" == "aarch64" ]]
then
  graal_arch="aarch64"
fi

# Oracle GraalVM for JDK 21 (LTS).
#
# Two changes from the previous GraalVM CE 22.3.0 / JDK 11 setup:
#   1. JDK 11 -> JDK 21. JDK 11 is the reason the toolchain was pinned to a
#      2022-era GraalVM at all.
#   2. native-image now ships *inside* the distribution, so the separate
#      `gu install native-image` step is gone. `gu` does not exist in this
#      layout; keeping the call would fail the build.
#
# Distribution note: this is Oracle GraalVM (GFTC licence), not GraalVM
# Community. Community for JDK 21 would also work for a plain `./release`, but
# does NOT ship -O3 or PGO, both of which the perf/* branches depend on.
graal_ver="21"
graal_os="$( uname -s | tr "[:upper:]" "[:lower:]")"
graal_ar="graalvm-jdk-${graal_ver}_${graal_os}-${graal_arch}_bin.tar.gz"
graal_url="https://download.oracle.com/graalvm/${graal_ver}/latest/${graal_ar}"

# Start fresh
rm -rf graalvm-extract
mkdir -p graalvm-extract

# Download Graal
echo "Downloading GraalVM from: ${graal_url}"
curl -L "${graal_url}" > "${graal_ar}"
tar -xzf "${graal_ar}" -C graalvm-extract --strip-components=1

graal_bin="$(pwd)/graalvm-extract/bin"
if [ ! -d "${graal_bin}" ]
then
    graal_bin="$(pwd)/graalvm-extract/Contents/Home/bin"
fi
export PATH="${graal_bin}:${PATH}"
export FPP_GRAALVM_JAVA_HOME="$(dirname ${graal_bin})"
# `release` reads GRAALVM_JAVA_HOME; `install-trace` reads FPP_GRAALVM_JAVA_HOME.
# Export both so either entry point works from this action.
export GRAALVM_JAVA_HOME="${FPP_GRAALVM_JAVA_HOME}"

"${graal_bin}/native-image" --version

if [ -n "$GITHUB_ENV" ]
then
    echo PATH="${PATH}" >> $GITHUB_ENV
    echo FPP_GRAALVM_JAVA_HOME="${FPP_GRAALVM_JAVA_HOME}" >> $GITHUB_ENV
    echo GRAALVM_JAVA_HOME="${GRAALVM_JAVA_HOME}" >> $GITHUB_ENV
fi
